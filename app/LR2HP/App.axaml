<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LR2HP.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#C9D1DE" />
        <ColorPaletteResources x:Key="Light" Accent="#3A4250" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://LR2HP/UI/AppStyles.axaml" />
  </Application.Styles>
</Application>
