<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LR2HP.UI.MainWindow"
        x:CompileBindings="False"
        Title="lr2hp-for-osu"
        Icon="avares://lr2hp-for-osu/Assets/lr2hp-for-osu.ico"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource PageBrush}">
  <Grid Background="Transparent" PointerPressed="DragWindow">
    <!-- Beatmap background under everything, faded into the page colour -->
    <Panel ClipToBounds="True" IsHitTestVisible="False">
      <!-- A brush, not an Image: the picture must not size the window -->
      <Border>
        <Border.Background>
          <ImageBrush Source="{Binding BackgroundImage}" Stretch="UniformToFill" AlignmentY="Top" />
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="{DynamicResource BannerScrim62Color}" />
            <GradientStop Offset="0.45" Color="{DynamicResource BannerScrim80Color}" />
            <GradientStop Offset="1" Color="{DynamicResource BannerScrim92Color}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Panel>

    <StackPanel>
      <Border Padding="16,8,10,8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Border Classes="pill" Classes.ok="{Binding AllConnected}" Padding="10,4" ToolTip.Tip="{Binding ConnectionDetails}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionText}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <!-- Always on top -->
            <ToggleButton x:Name="PinButton" Classes="ghost pin" MinHeight="32" Padding="8,0" Click="TogglePin" AutomationProperties.Name="Always on top">
              <ToggleButton.Background>
                <SolidColorBrush Color="{DynamicResource BannerScrim62Color}" />
              </ToggleButton.Background>
              <Path Width="14" Height="14" Stretch="Uniform" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
            </ToggleButton>
            <!-- Settings -->
            <Button Classes="ghost icon" MinHeight="32" Padding="8,0" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
              <Button.Background>
                <SolidColorBrush Color="{DynamicResource BannerScrim62Color}" />
              </Button.Background>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" Opening="SettingsOpening">
                  <StackPanel Width="250" Spacing="12" Margin="2">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="Theme" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="ThemeDark" GroupName="theme" Content="Dark" IsCheckedChanged="ThemeChanged" />
                        <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Light" IsCheckedChanged="ThemeChanged" />
                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Content="System" IsCheckedChanged="ThemeChanged" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="EX-HARD / FAILED lamp blink" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="BlinkSoft" GroupName="blink" Content="Soft" IsCheckedChanged="BlinkChanged" ToolTip.Tip="A slow fade between the two colours" />
                        <RadioButton x:Name="BlinkSkin" GroupName="blink" Content="Skin" IsCheckedChanged="BlinkChanged" ToolTip.Tip="As fast as the m_select skin (100 ms / 50 ms)" />
                        <RadioButton x:Name="BlinkOff" GroupName="blink" Content="Off" IsCheckedChanged="BlinkChanged" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="Song and artist names" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="TitlesOriginal" GroupName="titles" Content="Original" IsCheckedChanged="TitlesChanged" />
                        <RadioButton x:Name="TitlesEnglish" GroupName="titles" Content="English" IsCheckedChanged="TitlesChanged" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="Key bindings" />
                      <Button HorizontalAlignment="Stretch" MinHeight="34" Click="SyncKeys" Content="Refresh from osu!lazer / osu!stable" />
                      <TextBlock x:Name="KeysInfo" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" FontSize="12" FontWeight="SemiBold" Text="Data" />
                      <Button HorizontalAlignment="Stretch" MinHeight="34" Click="OpenFolder" Content="Open data folder" />
                      <TextBlock x:Name="FolderInfo" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <Path Width="15" Height="15" Stretch="Uniform" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
            </Button>
            <Button Classes="ghost" MinHeight="32" Padding="8,0" Click="CloseApp" ToolTip.Tip="Close lr2hp-for-osu" AutomationProperties.Name="Close">
              <Button.Background>
                <SolidColorBrush Color="{DynamicResource BannerScrim62Color}" />
              </Button.Background>
              <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round"
                    Data="M6,6 L18,18 M18,6 L6,18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Margin="16,12,16,14" Spacing="10">
        <Border Classes="pill" Padding="10,6" CornerRadius="8" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorText}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="1">
          <TextBlock Text="{Binding BeatmapTitle}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="secondary" FontSize="12" Text="{Binding BeatmapSubtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Best clear at the selected rate -->
        <Border Background="{DynamicResource TargetRowBrush}" CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasBest}" ToolTip.Tip="{Binding BestTip}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Clear lamp, as the m_select skin's song list draws it -->
            <Panel Width="10">
              <Border Background="{Binding BestBrush}" />
              <Border Classes="lampflash" Classes.slow="{Binding LampFlashSlow}" Classes.fast="{Binding LampFlashFast}" Classes.soft="{Binding LampFlashSoft}" Background="{Binding BestFlashBrush}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="1" Margin="12,10,8,10">
              <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TargetLabelBrush}" Text="{Binding BestHeader}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontWeight="Bold" FontSize="15" Foreground="{Binding BestBrush}" Text="{Binding BestLamp}" />
              <TextBlock Classes="secondary mono" FontSize="12" Text="{Binding BestDetail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- BMS rank and the nearer rank line -->
            <StackPanel Grid.Column="2" Margin="0,8,14,8" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock FontSize="26" FontWeight="Black" Foreground="{Binding RankBrush}" Text="{Binding RankText}" TextAlignment="Right" LineHeight="28" />
              <TextBlock Classes="mono secondary" FontSize="12" FontWeight="SemiBold" Text="{Binding RankDiff}" TextAlignment="Right" />
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Classes="muted" FontSize="13" Text="{Binding NoBestText}" IsVisible="{Binding !HasBest}" />

        <!-- Lamps at other rates -->
        <ItemsControl ItemsSource="{Binding OtherRates}" IsVisible="{Binding HasOtherRates}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="chip" ToolTip.Tip="{Binding Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ChipTextBrush}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
